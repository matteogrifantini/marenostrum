# Mare Nostrum / Supabase project: hivenxncleensmvvhkou
# Public: this URL is intentionally available to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://hivenxncleensmvvhkou.supabase.co

# Supabase API key name in the dashboard: marenostrum_publishable
# Public: use the Supabase Publishable key for this project.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase API key name in the dashboard: marenostrum_secret
# Server-only: use the Supabase Secret key (or the legacy service_role key).
# Never prefix this variable with NEXT_PUBLIC_ and never commit its value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: shared only between Vercel Production and GitHub Actions.
# Generate locally, for example: openssl rand -hex 32
CRON_SECRET=

# GitHub Actions only: production origin called by forecast-sync.yml.
# Keep this as the public Vercel alias, without a trailing slash.
FORECAST_SYNC_URL=https://marenostrum-theta.vercel.app
